import React, { useState, useEffect, useRef, useCallback } from "react";

// ---------------------------------------------------------------
// Design tokens — herbarium field-journal palette
// ---------------------------------------------------------------
const T = {
  bg: "#1c2717",
  bgDeep: "#0e150a",
  card: "#f4efdf",
  cardHi: "#faf6ea",
  ink: "#2b2318",
  inkSoft: "#5c5341",
  cream: "#f4efe0",
  creamDim: "rgba(244,239,224,.64)",
  gold: "#c28a3c",
  sage: "#8a9a6e",
  sageDeep: "#5d6b46",
  rust: "#a8471f",
  teal: "#4f7a6e",
  line: "rgba(43,35,24,.14)",
  lineLight: "rgba(244,239,224,.14)",
};

const ACCENTS = [T.sageDeep, T.gold, T.teal, T.rust, T.sageDeep, T.gold, T.teal];

// Wikimedia Commons — real photographs, one per plant
const wiki = (file, w) =>
  `https://commons.wikimedia.org/wiki/Special:FilePath/${file}?width=${w}`;

const SLIDES = [
  {
    tag: "No. 01",
    title: "Holy Basil (Tulsi)",
    sci: "Ocimum sanctum",
    desc: "A sacred, highly aromatic plant commonly found in almost every Hindu household.",
    img: wiki("Ocimum_tenuiflorum.jpg", 1400),
    imgAlt: "Holy basil (tulsi) plant with green leaves",
    props: [
      { label: "Respiratory Health", text: "Leaves boiled in water serve as an effective treatment for common colds, coughs, and sore throats." },
      { label: "Antimicrobial Properties", text: "Rich in agents that actively fight harmful bacteria and viruses." },
      { label: "Digestive Aid", text: "Helps stimulate appetite and ensures smooth overall digestion." },
      { label: "Adaptogen", text: "Functions as a natural adaptogen to help the body adapt to and cope with stress." },
      { label: "Other Uses", text: "Used as a natural disinfectant to purify water, and as an aromatic spice in tea and food." },
    ],
  },
  {
    tag: "No. 02",
    title: "Neem",
    sci: "Azadirachta indica",
    desc: "A tall, hardy tree known for its extremely bitter leaves, bark, and seeds.",
    img: wiki("Azadirachta_indica-Neem_tree.jpg", 1400),
    imgAlt: "Neem tree with dense green foliage",
    props: [
      { label: "Skin Diseases", text: "Highly effective in treating conditions like acne, eczema, and various other skin infections." },
      { label: "Blood Purifier", text: "Considered a natural blood purifier that also aids in reducing cholesterol levels." },
      { label: "Antimicrobial", text: "Widely formulated into soaps and creams due to its strong antiseptic properties." },
      { label: "Dental Health", text: "Neem twigs are traditionally used as natural toothbrushes to prevent gum disease and preserve oral hygiene." },
    ],
  },
  {
    tag: "No. 03",
    title: "Heart-leaved Moonseed (Gurjo)",
    sci: "Tinospora cordifolia",
    desc: "A climbing shrub frequently found in wild forests as well as plant nurseries.",
    img: wiki("Tinospora_cordifolia.jpg", 1400),
    imgAlt: "Tinospora cordifolia climbing vine with heart-shaped leaves",
    props: [
      { label: "Immunity Booster", text: "Its primary medicinal application is to significantly enhance the body's immune system." },
      { label: "Antioxidant", text: "Contains active compounds that fight off oxidative stress throughout the body." },
      { label: "Antipyretic", text: "Acts as a natural fever reducer." },
      { label: "Caution", text: "Excessive consumption must be avoided, as it can dangerously lower blood sugar levels.", caution: true },
    ],
  },
  {
    tag: "No. 04",
    title: "Asiatic Pennywort (Ghod Tapre)",
    sci: "Centella asiatica",
    desc: "A low-growing, creeping herb that forms a dense green carpet in shady, moist areas.",
    img: wiki("Centella_asiatica.jpg", 1400),
    imgAlt: "Centella asiatica creeping herb with round scalloped leaves",
    props: [
      { label: "Brain Tonic", text: "Enhances memory recall and overall mental capacity; commonly used as a restorative nerve tonic." },
      { label: "Wound Healing", text: "Fresh paste made directly from its leaves is applied externally to treat open wounds and burns." },
      { label: "Anti-stress", text: "Helps relieve symptoms associated with mild anxiety and depression." },
      { label: "Cosmetics", text: "Integrated into skin creams for its powerful healing and rejuvenating properties." },
    ],
  },
  {
    tag: "No. 05",
    title: "Turmeric (Besar)",
    sci: "Curcuma longa",
    desc: "A perennial herb recognized for its underground rhizomes that exhibit a vibrant bright yellow color.",
    img: wiki("Curcuma_longa_roots.jpg", 1400),
    imgAlt: "Fresh turmeric rhizomes, bright yellow-orange inside",
    props: [
      { label: "Antiseptic", text: "Applied topically to disinfect minor cuts, abrasions, and open wounds." },
      { label: "Anti-inflammatory", text: "Contains curcumin, its key active compound, which significantly reduces internal and external inflammation." },
      { label: "Immunity", text: "Acts as a daily dietary booster for the immune system." },
      { label: "Versatile Use", text: "Serves as a fundamental culinary spice, a natural fabric/food dye, and an ingredient in cosmetic products." },
    ],
  },
  {
    tag: "No. 06",
    title: "Malabar Nut (Asuro)",
    sci: "Adhatoda vasica",
    desc: "A medium-sized shrub common throughout the Chure and Mahabharat mountain ranges.",
    img: wiki("Justicia_adhatoda_001.JPG", 1400),
    imgAlt: "Adhatoda vasica shrub with long lance-shaped leaves",
    props: [
      { label: "Respiratory Ailments", text: "Highly effective in managing severe respiratory conditions such as asthma, bronchitis, and common colds by clearing mucus from the lungs." },
      { label: "Antimicrobial", text: "Used as a throat gargle to target tooth and gum problems." },
      { label: "Agricultural Use", text: "Leaves are frequently utilized as a nutrient-rich green manure in agricultural fields." },
    ],
  },
  {
    tag: "No. 07",
    title: "Calamus (Bojo)",
    sci: "Acorus calamus",
    desc: "An erect, aromatic herb typically found growing naturally in swampy, marshy lands.",
    img: wiki("Acorus_calamus_002.JPG", 1400),
    imgAlt: "Acorus calamus reed-like leaves growing in marshland",
    props: [
      { label: "Digestive Aid", text: "Offers fast relief for an upset stomach, intestinal gas, and loss of appetite." },
      { label: "Throat Disorders", text: "Highly beneficial for soothing sore throats and alleviating hoarseness in the voice." },
      { label: "Caution", text: "Should be used carefully, as excessive use can cause nausea, vomiting, and other adverse side effects.", caution: true },
    ],
  },
];

const TOTAL = SLIDES.length + 2; // hero + plants + closing

export default function Presentation() {
  const [expanded, setExpanded] = useState(() => new Set());
  const [revealed, setRevealed] = useState(() => new Set([0]));
  const [active, setActive] = useState(0);
  const [progress, setProgress] = useState(0);

  const sectionRefs = useRef([]);
  sectionRefs.current = [];
  const addRef = useCallback((el) => {
    if (el && !sectionRefs.current.includes(el)) sectionRefs.current.push(el);
  }, []);

  const toggle = useCallback((idx) => {
    setExpanded((prev) => {
      const next = new Set(prev);
      if (next.has(idx)) next.delete(idx);
      else next.add(idx);
      return next;
    });
  }, []);

  // scroll-into-view reveal + active-section tracking
  useEffect(() => {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const idx = Number(entry.target.dataset.idx);
          if (entry.isIntersecting) {
            setRevealed((prev) => (prev.has(idx) ? prev : new Set(prev).add(idx)));
            if (entry.intersectionRatio > 0.5) setActive(idx);
          }
        });
      },
      { threshold: [0, 0.15, 0.5, 0.85] }
    );
    sectionRefs.current.forEach((el) => obs.observe(el));
    return () => obs.disconnect();
  }, []);

  // overall scroll progress
  useEffect(() => {
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scroller = document.getElementById("np-scroll-root");
        if (scroller) {
          const max = scroller.scrollHeight - scroller.clientHeight;
          setProgress(max > 0 ? scroller.scrollTop / max : 0);
        }
        ticking = false;
      });
    };
    const scroller = document.getElementById("np-scroll-root");
    scroller?.addEventListener("scroll", onScroll, { passive: true });
    return () => scroller?.removeEventListener("scroll", onScroll);
  }, []);

  const jump = useCallback((idx) => {
    sectionRefs.current[idx]?.scrollIntoView({ behavior: "smooth", block: "start" });
  }, []);

  return (
    <div
      id="np-scroll-root"
      style={{
        fontFamily: "'Karla', sans-serif",
        width: "100%",
        height: "100vh",
        minHeight: 480,
        overflowY: "auto",
        overflowX: "hidden",
        background: T.bg,
        color: T.cream,
        position: "relative",
        scrollBehavior: "smooth",
      }}
      className="np-scroll"
    >
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Karla:wght@400;500;600;700&display=swap');

        .np-serif { font-family: 'Fraunces', serif; font-optical-sizing: auto; }

        .np-scroll { scrollbar-width: thin; scrollbar-color: rgba(194,138,60,.5) transparent; }
        .np-scroll::-webkit-scrollbar { width: 6px; }
        .np-scroll::-webkit-scrollbar-thumb { background: rgba(194,138,60,.4); border-radius: 4px; }
        .np-scroll::-webkit-scrollbar-track { background: transparent; }

        .np-reveal {
          opacity: 0;
          transform: translateY(26px);
          transition: opacity .8s cubic-bezier(.22,.61,.36,1), transform .8s cubic-bezier(.22,.61,.36,1);
        }
        .np-reveal.in { opacity: 1; transform: translateY(0); }

        .np-img-wrap { overflow: hidden; }
        .np-img { transition: transform 1.1s cubic-bezier(.22,.61,.36,1); }
        .np-reveal.in .np-img { transform: scale(1); }
        .np-img-wrap .np-img { transform: scale(1.08); }

        .np-toggle { transition: background .2s ease, border-color .2s ease, transform .15s ease; cursor: pointer; }
        .np-toggle:hover { border-color: var(--accent); background: rgba(194,138,60,.08); }
        .np-toggle:active { transform: scale(.98); }
        .np-plus { transition: transform .4s cubic-bezier(.22,.61,.36,1); display: inline-block; }
        .np-toggle.open .np-plus { transform: rotate(135deg); }

        .np-expand-wrap { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .55s cubic-bezier(.22,.61,.36,1); }
        .np-expand-wrap.open { grid-template-rows: 1fr; }
        .np-expand-inner { overflow: hidden; min-height: 0; }

        .np-prop-row {
          opacity: 0;
          transform: translateY(8px);
          transition: opacity .4s ease, transform .4s ease;
        }
        .np-expand-wrap.open .np-prop-row { opacity: 1; transform: translateY(0); }

        .np-dot { transition: background .25s ease, transform .25s ease; cursor: pointer; }
        .np-dot:hover { transform: scale(1.3); }

        .np-bounce { animation: npBounce 2.2s ease-in-out infinite; }
        @keyframes npBounce { 0%,100% { transform: translateY(0); opacity:.6; } 50% { transform: translateY(8px); opacity:1; } }

        @media (prefers-reduced-motion: reduce) {
          .np-reveal, .np-img, .np-plus, .np-expand-wrap, .np-prop-row, .np-bounce { transition: none !important; animation: none !important; opacity: 1 !important; transform: none !important; }
          .np-expand-wrap.open { grid-template-rows: 1fr; }
        }

        @media (max-width: 760px) {
          .np-plant-row { flex-direction: column !important; }
          .np-plant-row.rev { flex-direction: column !important; }
          .np-rail { display: none !important; }
        }
      `}</style>

      {/* top progress line */}
      <div style={{ position: "fixed", top: 0, left: 0, right: 0, height: 3, background: "rgba(244,239,224,.1)", zIndex: 40 }}>
        <div style={{ height: "100%", width: `${progress * 100}%`, background: T.gold, transition: "width .1s linear" }} />
      </div>

      {/* side progress rail */}
      <div className="np-rail" style={{ position: "fixed", right: 20, top: "50%", transform: "translateY(-50%)", display: "flex", flexDirection: "column", gap: 9, zIndex: 40 }}>
        {Array.from({ length: TOTAL }).map((_, idx) => (
          <span
            key={idx}
            className="np-dot"
            onClick={() => jump(idx)}
            title={idx === 0 ? "Introduction" : idx === TOTAL - 1 ? "Closing" : SLIDES[idx - 1].title}
            style={{
              width: idx === active ? 9 : 6,
              height: idx === active ? 9 : 6,
              borderRadius: 99,
              background: idx === active ? T.gold : "rgba(244,239,224,.35)",
            }}
          />
        ))}
      </div>

      {/* ---------------- HERO ---------------- */}
      <section
        ref={addRef}
        data-idx={0}
        style={{
          position: "relative",
          minHeight: "100vh",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          padding: "8vh 6vw",
        }}
      >
        <div className="np-img-wrap" style={{ position: "absolute", inset: 0, zIndex: 0 }}>
          <img
            src={wiki("Ocimum_tenuiflorum.jpg", 1800)}
            alt=""
            aria-hidden="true"
            className="np-img"
            style={{ width: "100%", height: "100%", objectFit: "cover", filter: "saturate(0.85) brightness(0.55)" }}
          />
          <div style={{ position: "absolute", inset: 0, background: `linear-gradient(180deg, ${T.bgDeep}cc 0%, ${T.bg}99 45%, ${T.bgDeep}ee 100%)` }} />
        </div>

        <div className={`np-reveal${revealed.has(0) ? " in" : ""}`} style={{ position: "relative", textAlign: "center", maxWidth: 680, width: "100%", zIndex: 1 }}>
          <div style={{ width: 56, height: 2, background: T.gold, margin: "0 auto 28px" }} />
          <h1 className="np-serif" style={{ fontSize: "clamp(2rem, 5vw, 3.6rem)", fontWeight: 500, lineHeight: 1.1, margin: "0 0 20px", color: T.cream }}>
            Nepal's Household Pharmacy
          </h1>
          <p style={{ color: T.creamDim, fontSize: "1.02rem", maxWidth: "46ch", margin: "0 auto 36px" }}>
            Seven plants that grow in courtyards, forests and kitchen pots across Nepal — each one a remedy passed down long before the pharmacy existed.
          </p>
          <div style={{ display: "flex", gap: 32, justifyContent: "center", flexWrap: "wrap" }}>
            {[["7", "Plants"], ["2000+", "Years in use"], ["0", "Synthetic origin"]].map(([n, l]) => (
              <div key={l}>
                <div className="np-serif" style={{ fontSize: "1.7rem", color: T.gold }}>{n}</div>
                <div style={{ fontSize: ".72rem", color: T.creamDim, marginTop: 2 }}>{l}</div>
              </div>
            ))}
          </div>
        </div>

        <div className="np-bounce" style={{ position: "absolute", bottom: 28, left: "50%", transform: "translateX(-50%)", color: T.creamDim, zIndex: 1 }}>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 8L10 13L15 8" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" /></svg>
        </div>
      </section>

      {/* ---------------- PLANT SECTIONS ---------------- */}
      {SLIDES.map((slide, i) => {
        const idx = i + 1;
        const accent = ACCENTS[i % ACCENTS.length];
        const isOpen = expanded.has(i);
        const reversed = i % 2 === 1;
        return (
          <section
            key={slide.title}
            ref={addRef}
            data-idx={idx}
            style={{ minHeight: "100vh", display: "flex", alignItems: "center", padding: "8vh 6vw", background: T.card, color: T.ink }}
          >
            <div
              className={`np-plant-row${reversed ? " rev" : ""}`}
              style={{ display: "flex", flexDirection: reversed ? "row-reverse" : "row", alignItems: "center", gap: "6vw", maxWidth: 1180, width: "100%", margin: "0 auto" }}
            >
              {/* image */}
              <div className={`np-reveal${revealed.has(idx) ? " in" : ""}`} style={{ flex: "1 1 44%", minWidth: 0 }}>
                <div className="np-img-wrap" style={{ borderRadius: 14, aspectRatio: "4/5", boxShadow: "0 20px 50px rgba(14,21,10,.35)" }}>
                  <img
                    src={slide.img}
                    alt={slide.imgAlt}
                    loading="lazy"
                    className="np-img"
                    style={{ width: "100%", height: "100%", objectFit: "cover", display: "block" }}
                  />
                </div>
              </div>

              {/* text */}
              <div className={`np-reveal${revealed.has(idx) ? " in" : ""}`} style={{ flex: "1 1 56%", minWidth: 0, transitionDelay: "80ms" }}>
                <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 10 }}>
                  <span style={{ fontSize: ".72rem", letterSpacing: ".06em", color: accent, border: `1px solid ${accent}`, borderRadius: 999, padding: "3px 10px" }}>
                    {slide.tag}
                  </span>
                  <span style={{ fontSize: ".9rem", fontStyle: "italic", color: T.inkSoft }}>{slide.sci}</span>
                </div>

                <h2 className="np-serif" style={{ fontSize: "clamp(1.6rem, 3.4vw, 2.5rem)", fontWeight: 500, margin: "0 0 14px", color: T.ink }}>
                  {slide.title}
                </h2>
                <p style={{ fontSize: "1.03rem", lineHeight: 1.6, color: T.ink, margin: "0 0 22px", maxWidth: "56ch" }}>{slide.desc}</p>

                <button
                  className={`np-toggle${isOpen ? " open" : ""}`}
                  onClick={() => toggle(i)}
                  style={{
                    "--accent": accent,
                    display: "inline-flex",
                    alignItems: "center",
                    gap: 8,
                    border: `1px solid ${isOpen ? accent : T.line}`,
                    background: "transparent",
                    color: T.ink,
                    borderRadius: 999,
                    padding: "9px 16px 9px 18px",
                    fontSize: ".85rem",
                    fontFamily: "'Karla', sans-serif",
                    fontWeight: 600,
                  }}
                  aria-expanded={isOpen}
                >
                  {isOpen ? "Hide medicinal uses" : "See medicinal uses"}
                  <span className="np-plus" style={{ fontSize: "1.05rem", lineHeight: 1, color: accent }}>+</span>
                </button>

                <div className={`np-expand-wrap${isOpen ? " open" : ""}`}>
                  <div className="np-expand-inner">
                    <div style={{ display: "flex", flexDirection: "column", gap: 10, marginTop: 18 }}>
                      {slide.props.map((p, pIdx) => (
                        <div
                          key={p.label}
                          className="np-prop-row"
                          style={{
                            transitionDelay: isOpen ? `${120 + pIdx * 70}ms` : "0ms",
                            display: "flex",
                            gap: 12,
                            padding: "13px 16px",
                            borderRadius: 10,
                            background: p.caution ? "rgba(168,71,31,.07)" : T.cardHi,
                            border: p.caution ? `1px solid ${T.rust}` : `1px solid ${T.line}`,
                          }}
                        >
                          <span
                            aria-hidden="true"
                            style={{
                              flexShrink: 0,
                              marginTop: 6,
                              width: 8,
                              height: 8,
                              borderRadius: 99,
                              background: p.caution ? T.rust : accent,
                            }}
                          />
                          <div>
                            <span style={{ fontWeight: 700, color: p.caution ? T.rust : T.ink, fontSize: ".92rem" }}>
                              {p.label}:{" "}
                            </span>
                            <span style={{ fontSize: ".92rem", lineHeight: 1.55, color: T.ink }}>{p.text}</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
        );
      })}

      {/* ---------------- CLOSING ---------------- */}
      <section
        ref={addRef}
        data-idx={TOTAL - 1}
        style={{ position: "relative", minHeight: "100vh", display: "flex", alignItems: "center", justifyContent: "center", padding: "8vh 6vw" }}
      >
        <div className="np-img-wrap" style={{ position: "absolute", inset: 0, zIndex: 0 }}>
          <img
            src={wiki("Curcuma_longa_roots.jpg", 1800)}
            alt=""
            aria-hidden="true"
            className="np-img"
            style={{ width: "100%", height: "100%", objectFit: "cover", filter: "saturate(0.8) brightness(0.42)" }}
          />
          <div style={{ position: "absolute", inset: 0, background: `linear-gradient(180deg, ${T.bgDeep}ee 0%, ${T.bg}99 40%, ${T.bgDeep}ee 100%)` }} />
        </div>

        <div className={`np-reveal${revealed.has(TOTAL - 1) ? " in" : ""}`} style={{ position: "relative", textAlign: "center", maxWidth: 620, width: "100%", zIndex: 1 }}>
          <div style={{ display: "flex", justifyContent: "center", gap: 8, marginBottom: 26 }}>
            {SLIDES.map((s, idx) => (
              <span key={s.title} style={{ width: 8, height: 8, borderRadius: 99, background: ACCENTS[idx % ACCENTS.length] }} />
            ))}
          </div>
          <div style={{ width: 56, height: 2, background: T.gold, margin: "0 auto 26px" }} />
          <h2 className="np-serif" style={{ fontSize: "clamp(1.7rem, 4vw, 2.6rem)", fontWeight: 500, margin: "0 0 18px", color: T.cream }}>
            Grown at home, trusted for generations
          </h2>
          <p style={{ color: T.creamDim, fontSize: "1rem", maxWidth: "50ch", margin: "0 auto 34px", lineHeight: 1.65 }}>
            From a courtyard tulsi plant to a roadside neem tree, these seven remedies show how much medicine has quietly grown around Nepali homes all along.
          </p>
          <button
            onClick={() => jump(0)}
            style={{
              border: `1px solid ${T.gold}`,
              background: "transparent",
              color: T.gold,
              borderRadius: 999,
              padding: "10px 22px",
              fontSize: ".85rem",
              letterSpacing: ".02em",
              cursor: "pointer",
              fontFamily: "'Karla', sans-serif",
              transition: "background .2s ease",
            }}
          >
            ↺ Back to the beginning
          </button>
        </div>
      </section>
    </div>
  );
}
